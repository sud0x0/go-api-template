# ============================================================================
# THIS IS FOR LOCAL DEVELOPMENT ONLY
# ============================================================================

# golang:1.26-alpine, pinned to its MULTI-ARCH manifest-list digest (works on
# amd64 + arm64). Tag is mutable, digest is immutable. Keep in sync with the
# builder stage in container.prod. To bump: re-resolve the tag's manifest-list
# digest and update the tag comment with it.
FROM golang@sha256:3ad57304ad93bbec8548a0437ad9e06a455660655d9af011d58b993f6f615648

# Pin tool versions for reproducible local development.
# goose CLI is intentionally NOT installed — migrations are run via the
# embedded migrator at cmd/migrate (see `make db-migrate`).
RUN go install github.com/air-verse/air@v1.65.3

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

EXPOSE 8080

CMD ["air", "-c", ".air.toml"]
