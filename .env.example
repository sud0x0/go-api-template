# ===========================================
# Copy this file to .env and fill in values
# Never commit .env to version control
# ===========================================

# Server
PORT=8080
# Internal admin port. Serves /livez, /readyz, /health. Restrict access at
# the infrastructure layer (NetworkPolicy / firewall) so it never crosses
# the public boundary. Metrics no longer live here: they are pushed via OTLP to
# the Collector (see OTEL_* below), not scraped from the app.
METRICS_PORT=9090

# Server timeouts (optional - defaults shown, in seconds)
SERVER_READ_HEADER_TIMEOUT_SECS=5
SERVER_READ_TIMEOUT_SECS=10
SERVER_WRITE_TIMEOUT_SECS=65
SERVER_IDLE_TIMEOUT_SECS=120
SERVER_REQUEST_TIMEOUT_SECS=60

# Proxy / edge (optional - defaults shown)
# Trust X-Forwarded-For / X-Real-IP headers (chimw.RealIP). These headers are
# client-spoofable, so this is OFF by default. Set true ONLY when a trusted
# reverse proxy / load balancer overwrites them on every request — otherwise an
# attacker can forge the client IP in your logs (and in any IP-keyed limiter).
TRUST_PROXY_HEADERS=false

# App-level rate limit (requests per minute per client IP). 0 = DISABLED (the
# default): the middleware is not registered at all. The PRIMARY rate-limit
# control is the network edge (load balancer / gateway / WAF); this is only a
# fallback for edge-less deployments. Counters are in-memory PER INSTANCE, so
# the effective global limit is RATE_LIMIT_RPM × replica count. If you enable
# this behind a proxy, also set TRUST_PROXY_HEADERS=true or every request shares
# the proxy's IP and lands in one bucket.
RATE_LIMIT_RPM=0

# Serve /readyz and /health on the PUBLIC listener. Default true (backwards
# compatible). Set false to keep readiness — a DB ping plus an operational-state
# signal — on the internal admin port (:METRICS_PORT) only. /livez stays public
# either way so the container HEALTHCHECK keeps working.
PUBLIC_READINESS=true

# Database (required)
# The Postgres container in compose.dev.yaml reads these same variables, so
# this is the single source of truth — no separate POSTGRES_* set to maintain.
DB_HOST=db
DB_PORT=5432
DB_USER=appuser
DB_PASSWORD=changeme
DB_NAME=appdb
DB_SSLMODE=disable

# Database connection pool (optional - defaults shown)
# DB_MAX_OPEN_CONNS must be in [1, 2147483647]; DB_MIN_CONNS in [0, DB_MAX_OPEN_CONNS].
DB_MAX_OPEN_CONNS=100
DB_MIN_CONNS=10
DB_CONN_MAX_LIFETIME_MINS=5
DB_CONN_MAX_IDLE_TIME_MINS=10

# Logging
# Options: development, production, quiet, silent.
# Default when UNSET is `production` (info level) — a fail-safe so prod never
# accidentally ships debug logs. This file sets `development` for local dev.
LOG_LEVEL=development

# Observability (OpenTelemetry)
# Traces and metrics are pushed over OTLP to a local Collector, which batches
# them and re-exposes Prometheus for scraping. Logs stay on slog JSON to stdout
# (see the README "Observability" section). Correlation: each log line carries
# trace_id and span_id when a request has an active span.
#
# OTLP Collector endpoint (OTLP/HTTP, port 4318). When UNSET, telemetry is
# DISABLED: the app installs no-op providers, boots normally, and logs one line
# saying so. In compose.dev.yaml this points at the otel-collector service.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# service.name resource attribute. Defaults to go-api (matches the log service
# attribute) so a log line and its trace share one service identity.
OTEL_SERVICE_NAME=go-api
# Explicit on/off override. When UNSET it defaults to "enabled if an endpoint is
# set", so the line above is enough to turn telemetry on. Set false to disable
# even with an endpoint present. OTEL_ENABLED=true with no endpoint fails fast.
#OTEL_ENABLED=true

# CORS (comma-separated explicit origins). A wildcard (`*`, or any entry
# containing `*`) is REJECTED at startup — the middleware matches origins
# exactly, so a wildcard is silently inert. Leave empty for a server-to-server
# API with no browser clients.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Only set true if your browser clients need to send cookies / credentials.
# Startup also rejects CORS_ALLOW_CREDENTIALS=true with an empty origin list
# (credentialed CORS with no allowed origins can never succeed).
CORS_ALLOW_CREDENTIALS=false

# Migrator (cmd/migrate) — optional; defaults shown
# Postgres lock_timeout and statement_timeout for the migration session.
# Raise statement_timeout for long data backfills; lock_timeout should stay
# short (a few seconds) so migrations fail fast rather than queue behind
# long-running queries and block production traffic.
#MIGRATOR_LOCK_TIMEOUT=5s
#MIGRATOR_STATEMENT_TIMEOUT=10min
# Set to "true" alongside --confirm-destructive to enable down/down-to/redo/reset.
#MIGRATOR_ALLOW_DESTRUCTIVE=false

# Timezone
TZ=Australia/Melbourne
